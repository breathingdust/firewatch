{
  "name": "firewatch",
  "version": "2.0.2",
  "description": "Monitors a GitHub repository for issues or pull requests that receive upvotes over a certain rate in a timeperiod",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "lint": "npx eslint .",
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "local-action": "npx @github/local-action . src/main.js .env",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.js",
    "package:watch": "npm run package -- --watch"
  },
  "author": "Simon Davis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/breathingdust/firewatch/issues"
  },
  "homepage": "https://github.com/breathingdust/firewatch#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "adm-zip": "^0.6.1",
    "axios": "^1.13.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
